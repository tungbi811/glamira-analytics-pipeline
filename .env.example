# Copy to .env and fill in the values: cp .env.example .env
# .env is gitignored; never commit real passwords.

# GCP
GCP_PROJECT_ID=your-project-id
GCS_BUCKET=gs://your-project-id-raw

# MongoDB (on the VM)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=glamira
MONGO_USER=glamira
MONGO_PASSWORD=change-me
MONGO_ADMIN_PASSWORD=change-me
